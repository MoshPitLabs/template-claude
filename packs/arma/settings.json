      "mcp__enfusion-mcp__wb_save",
      "mcp__enfusion-mcp__wb_cleanup",
      "mcp__enfusion-mcp__server_launch",
      "mcp__enfusion-mcp__server_stop",
      "Edit(**/Scripts/WorkbenchGame/EnfusionMCP/**)",
      "Edit(**/*.xob)",
      "Edit(**/*.edds)",
      "Edit(**/resourceDatabase.rdb)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__enfusion-mcp__wb_.*",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/wb-launch-guard.sh"
          }
        ]
      }
    ]
  }
}
